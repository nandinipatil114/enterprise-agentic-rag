cat > .env.example <<'EOF'
# Get a free key at https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=gsk_your_key_here

# Chat model on Groq. Check https://console.groq.com/docs/models if this ever returns a 404.
GROQ_MODEL=openai/gpt-oss-120b

# Local embeddings (no key needed, downloaded once on first run)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EOF